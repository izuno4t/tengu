{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,ja",
  "useGitignore": true,
  "files": [
    "**/*.{md,rs,toml,yml,yaml,json,sh,txt}"
  ],
  "ignorePaths": [
    "target/**",
    ".git/**",
    ".tengu/**",
    "scripts/__pycache__/**",
    "Cargo.lock",
    "docs/REQUIREMENTS.md"
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "/```[\\s\\S]*?```/g"
  ],
  "words": [
    "AGENT",
    "AGENTS",
